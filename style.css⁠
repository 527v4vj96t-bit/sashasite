* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
}

body {
  background: linear-gradient(135deg, #fef9c3 0%, #e0f2fe 50%, #f3e8ff 100%);
  background-attachment: fixed;
  color: #0f172a;
  padding-top: 100px;
}

/* Шапка */
.navbar {
  position: fixed;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  width: 90%;
  max-width: 1100px;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(15px);
  padding: 12px 24px;
  border-radius: 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 1000;
  border: 1px solid rgba(255, 255, 255, 0.4);
}

.logo {
  font-weight: 800;
  font-size: 18px;
}

.small-logo {
  font-size: 12px;
  color: #64748b;
  font-weight: normal;
}

.nav-links a {
  margin: 0 12px;
  text-decoration: none;
  color: #334155;
  font-size: 14px;
  font-weight: 500;
}

/* Главный экран */
.hero {
  text-align: center;
  padding: 80px 20px;
  max-width: 800px;
  margin: 0 auto;
}

.hero h1 {
  font-size: 48px;
  margin-bottom: 20px;
}

.gradient-text {
  background: linear-gradient(90deg, #3b82f6, #a855f7);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-subtitle {
  font-size: 20px;
  color: #475569;
  margin-bottom: 12px;
}

.hero-badge {
  color: #0284c7;
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 30px;
}

/* Кнопки */
.btn-primary, .btn-dark, .btn-light {
  padding: 12px 24px;
  border-radius: 30px;
  text-decoration: none;
  font-weight: 600;
  font-size: 14px;
  display: inline-block;
  transition: transform 0.2s ease;
}

.btn-primary, .btn-dark {
  background: #0f172a;
  color: #ffffff;
}

.btn-light {
  background: #ffffff;
  color: #0f172a;
  margin-left: 10px;
}

/* Секции и Матовые Карточки */
.section {
  max-width: 800px;
  margin: 60px auto;
  padding: 0 20px;
}

.section-tag {
  background: #ffffff;
  width: 30px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  font-size: 11px;
  color: #64748b;
  margin-bottom: 10px;
}

.glass-card {
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 28px;
  padding: 36px;
  margin-top: 20px;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.03);
}

.badge {
  background: #e0f2fe;
  color: #0369a1;
  font-size: 10px;
  font-weight: 700;
  padding: 6px 12px;
  border-radius: 12px;
  letter-spacing: 1px;
}

.price {
  font-size: 42px;
  font-weight: 800;
  margin: 15px 0;
}

.features-list {
  list-style: none;
  margin: 20px 0 30px 0;
}

.features-list li {
  margin-bottom: 10px;
  color: #334155;
}

.features-list li::before {
  content: "— ";
  color: #0284c7;
}

.full-width {
  display: block;
  text-align: center;
}

footer {
  text-align: center;
  padding: 40px;
  color: #94a3b8;
  font-size: 13px;
}
